# Backend application configuration (copy to .env and adjust as needed).
# The backend defaults to PostgreSQL; use a SQLite URL for a no-install local run.

# --- Runtime ---
APP_ENV=production

# --- Database ---
# PostgreSQL (prod / docker):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/placement_scheduler
# SQLite (local dev, no server required):
# DATABASE_URL=sqlite:///./dev.db

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Solver ---
SOLVER_TIME_LIMIT_SECONDS=10.0
SOLVER_WORKERS=8
